# URL pública final (canonical, OG, sitemap). En Cloudflare Pages se define como variable de build.
SITE_URL=https://victor-mendez.pages.dev

# Opcional: token de GitHub de solo lectura para evitar el límite de 60 peticiones/hora.
GITHUB_TOKEN=

# Opcional: token de Cloudflare Web Analytics. No hace falta si se activa desde el panel de Pages.
PUBLIC_CF_ANALYTICS_TOKEN=
