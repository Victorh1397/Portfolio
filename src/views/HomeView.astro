---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import ProjectFilter from '@/components/ProjectFilter.astro';
import { AREAS } from '@/content.config';
import { useTranslations, type Lang } from '@/i18n/ui';
import { alternates, routes } from '@/i18n/routes';
import { getProjects } from '@/lib/projects';
import { contactLinks, site } from '@/config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);

// Foto opcional (specs/011 R6): si existe src/assets/profile/photo.*, el hero pasa a dos columnas.
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/profile/photo.{jpg,jpeg,png,webp}', {
  eager: true,
});
const photo = Object.values(photos)[0]?.default;

// Solo las áreas que aparecen en algún proyecto, en el orden canónico.
const usedAreas = AREAS.filter((area) => projects.some((p) => p.data.areas.includes(area)));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL(routes.home(lang), Astro.site).href,
  jobTitle: t('home.eyebrow'),
  sameAs: contactLinks()
    .filter((l) => l.key !== 'email')
    .map((l) => l.href),
};
---

<Base
  lang={lang}
  title={t('meta.home.title')}
  description={t('meta.home.description')}
  alternates={alternates(routes.home)}
  current="home"
  jsonLd={jsonLd}
>
  <section class:list={['hero container', { 'has-photo': photo }]} aria-labelledby="hero-title">
    <p class="eyebrow">{t('home.eyebrow')}</p>
    <h1 id="hero-title">{t('home.title')}</h1>
    {
      photo && (
        <Image
          class="portrait"
          src={photo}
          alt={t('home.photoAlt')}
          widths={[320, 480, 640, 800]}
          sizes="(min-width: 900px) 22rem, 18rem"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <p class="intro">{t('home.intro')}</p>
  </section>

  <section id="proyectos" class="projects container" aria-labelledby="projects-title">
    <div class="projects-head">
      <h2 id="projects-title">{t('home.projects')}</h2>
    </div>

    <ProjectFilter lang={lang} areas={usedAreas} total={projects.length} target="project-list" />

    <ol id="project-list" class="list" role="list">
      {projects.map((project, i) => <ProjectRow project={project} index={i} lang={lang} />)}
    </ol>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .hero h1 {
    margin-top: var(--space-s);
    max-width: 14ch;
    font-size: var(--step-5);
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.025em;
  }

  .intro {
    margin-top: var(--space-m);
    max-width: 46ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .intro {
      margin-left: auto;
      margin-right: 8%;
      margin-top: var(--space-l);
    }
  }

  /* Con foto: texto a la izquierda, retrato 4:5 a la derecha. En móvil, el retrato va entre el titular y la intro. */
  .portrait {
    display: block;
    width: min(100%, 18rem);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-top: var(--space-l);
    filter: saturate(0.85);
  }

  @media (min-width: 900px) {
    .hero.has-photo {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      grid-template-areas:
        'eyebrow portrait'
        'title   portrait'
        'intro   portrait';
      grid-template-rows: auto auto 1fr;
      column-gap: var(--space-xl);
    }

    .has-photo .eyebrow {
      grid-area: eyebrow;
    }

    .has-photo h1 {
      grid-area: title;
    }

    .has-photo .intro {
      grid-area: intro;
      margin-left: 0;
      margin-right: 0;
    }

    .has-photo .portrait {
      grid-area: portrait;
      width: 100%;
      margin-top: 0;
      align-self: start;
    }
  }

  .projects {
    scroll-margin-top: var(--space-m);
  }

  .projects-head {
    margin-bottom: var(--space-m);
  }

  .projects-head h2 {
    font-size: var(--step-2);
  }

  .list {
    list-style: none;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
</style>
