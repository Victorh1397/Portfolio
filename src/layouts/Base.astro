---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@/styles/tokens.css';
import '@/styles/base.css';

import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { locales, otherLang, useTranslations, type Lang } from '@/i18n/ui';
import type { Alternates } from '@/i18n/routes';

export type NavKey = 'home' | 'about' | 'project' | 'none';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternates: Alternates;
  current?: NavKey;
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  alternates,
  current = 'none',
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const t = useTranslations(lang);
const site = Astro.site!;
const canonical = new URL(alternates[lang], site).href;
const altUrl = (l: Lang) => new URL(alternates[l], site).href;
const ogImage = new URL(`/og/og-${lang}.png`, site).href;
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang={locales[lang].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="alternate" hreflang="es" href={altUrl('es')} />
    <link rel="alternate" hreflang="en" href={altUrl('en')} />
    <link rel="alternate" hreflang="x-default" href={altUrl('es')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t('meta.siteName')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locales[lang].og} />
    <meta property="og:locale:alternate" content={locales[otherLang(lang)].og} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151412" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Aplica el tema guardado antes del primer pintado (specs/002 R4, R5). -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t('a11y.skip')}</a>
    <Header lang={lang} alternates={alternates} current={current} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
