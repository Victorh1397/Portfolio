---
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';
import { useTranslations, type Lang } from '@/i18n/ui';
import { routes, type Alternates } from '@/i18n/routes';
import type { NavKey } from '@/layouts/Base.astro';

interface Props {
  lang: Lang;
  alternates: Alternates;
  current: NavKey;
}

const { lang, alternates, current } = Astro.props;
const t = useTranslations(lang);
const home = routes.home(lang);
---

<header class="site-header container">
  <a class="wordmark" href={home} aria-current={current === 'home' ? 'page' : undefined}>
    Victor Mendez
  </a>
  <nav aria-label={t('nav.label')}>
    <ul>
      <li>
        <a href={`${home}#proyectos`} aria-current={current === 'project' ? 'true' : undefined}>
          {t('nav.projects')}
        </a>
      </li>
      <li>
        <a href={routes.about(lang)} aria-current={current === 'about' ? 'page' : undefined}>
          {t('nav.about')}
        </a>
      </li>
      <li><LangSwitch lang={lang} alternates={alternates} /></li>
      <li><ThemeToggle lang={lang} /></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-m);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-variation-settings: 'opsz' 24;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  ul {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
    list-style: none;
    padding: 0;
    font-size: var(--step--1);
  }

  nav a {
    text-decoration: none;
    color: var(--muted);
    white-space: nowrap;
  }

  nav a:hover,
  nav a[aria-current] {
    color: var(--fg);
  }

  nav a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.35em;
  }
</style>
