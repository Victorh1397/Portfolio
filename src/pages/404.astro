---
import Base from '@/layouts/Base.astro';
import { useTranslations } from '@/i18n/ui';
import { routes } from '@/i18n/routes';

// Página única y bilingüe: Cloudflare Pages sirve /404.html para cualquier ruta inexistente (specs/006 R8).
const es = useTranslations('es');
const en = useTranslations('en');
---

<Base
  lang="es"
  title={`404 · ${es('notFound.title')}`}
  description={es('notFound.body')}
  alternates={{ es: '/', en: '/en/' }}
  noindex
>
  <div class="container wrap">
    <p class="code mono" aria-hidden="true">404</p>
    <div class="cols">
      <section>
        <h1>{es('notFound.title')}</h1>
        <p>{es('notFound.body')}</p>
        <a href={routes.home('es')}>{es('notFound.back')} →</a>
      </section>
      <section lang="en">
        <h2>{en('notFound.title')}</h2>
        <p>{en('notFound.body')}</p>
        <a href={routes.home('en')}>{en('notFound.back')} →</a>
      </section>
    </div>
  </div>
</Base>

<style>
  .wrap {
    padding-block: var(--space-xl);
  }

  .code {
    color: var(--muted);
  }

  .cols {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 700px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  h1,
  h2 {
    font-size: var(--step-3);
  }

  p {
    margin-block: var(--space-s);
    color: var(--muted);
  }

  a {
    color: var(--accent);
  }
</style>
